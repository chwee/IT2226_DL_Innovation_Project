# ---------------------------------------------------------------------------
# Copy this file to  .env.local  and paste your own values in.
# Do NOT share .env.local or commit it - it contains live API keys.
# ---------------------------------------------------------------------------

# LiveKit Cloud  ->  https://cloud.livekit.io  ->  Settings -> Keys
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Groq  ->  https://console.groq.com/keys
# One key powers STT (Whisper), the LLM (GPT-OSS) and TTS (Orpheus).
GROQ_API_KEY=
