# Docker Model Runner's OpenAI-compatible endpoint.
# - Running the backend directly on the host (uvicorn, no Docker): use localhost.
# - Running the backend inside a container via docker-compose: use
#   http://model-runner.docker.internal/engines/v1 instead (see docker-compose.yml).
DMR_BASE_URL=http://localhost:12434/engines/v1

# Model to call for generation. Must already be pulled into Docker Model Runner
# (check with `docker model list`, pull with `docker model pull <name>`).
# Ministral 3 8B — small, fast local model, good default for quick
# interactive testing. It's not a reasoning model, so REASONING_EFFORT below
# is simply ignored by Docker Model Runner for this model.
DMR_MODEL=docker.io/ai/ministral3:8B-Q4_K_M
# Alternative: DMR_MODEL=ai/gpt-oss:latest
# Alternative: DMR_MODEL=huggingface.co/mradermacher/qwen-sea-lion-v4-32b-it-gguf:Q4_K_M — tuned
# for Southeast Asian languages (Malay, Tamil, Chinese, Indonesian, etc.), a
# better fit for OralLink's Singapore audience, but ~32B params is noticeably
# slower than the alternatives above on the same hardware.

# Number of knowledge-base chunks to retrieve and pass as context per question.
RAG_TOP_K=4

# Folder of documents to index for retrieval, relative to backend/ (or an absolute path).
DATA_DIR=data/sample

# Max tokens the model may generate per answer (gpt-oss spends some of this
# budget on its own chain-of-thought before the final answer).
RAG_MAX_TOKENS=800

# gpt-oss reasoning depth: low | medium | high. Lower is faster — useful for
# a snappy streaming UI; raise it if answers need deeper reasoning.
REASONING_EFFORT=low
